<Window x:Class="LongMarchWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LongMarchWindows.Controls"
        Title="长征路线图"
        Width="1100" Height="720"
        MinWidth="640" MinHeight="480"
        Background="#120a05"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <controls:MapGameControl x:Name="Map" ViewModel="{Binding}" />

        <!-- 锁定节点信息卡 -->
        <Grid x:Name="LockedOverlay"
              Visibility="{Binding LockedOverlayVisibility}"
              Background="#B3100502"
              MouseLeftButtonDown="OnLockedOverlayMouseDown">
            <Border x:Name="LockedCard"
                    Width="440"
                    MaxWidth="{Binding ActualWidth, ElementName=LockedOverlay}"
                    Padding="32"
                    CornerRadius="12"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="#FF23140C"
                    BorderBrush="#C8A03C"
                    BorderThickness="2"
                    MouseLeftButtonDown="OnLockedCardMouseDown">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="0" Color="#000000" Opacity="0.7" />
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center">
                    <Button Content="✕"
                            HorizontalAlignment="Right"
                            Foreground="#8B7355"
                            Background="Transparent"
                            BorderThickness="0"
                            FontSize="20"
                            Cursor="Hand"
                            Click="OnCloseLockedClick" />
                    <TextBlock Text="🔒" FontSize="48" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding LockedTitle}"
                               FontSize="24" FontWeight="Bold"
                               Foreground="#F0D68A"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,0" />
                    <TextBlock Text="— 待解锁 —"
                               FontSize="16" FontWeight="Bold"
                               Foreground="#C41E3A"
                               HorizontalAlignment="Center"
                               Margin="0,4,0,0" />
                    <TextBlock Text="{Binding LockedDesc}"
                               FontSize="16"
                               Foreground="#D4B896"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Margin="0,16,0,0" />
                    <TextBlock Text="请先完成前面的关卡"
                               FontSize="13"
                               Foreground="#8B7355"
                               HorizontalAlignment="Center"
                               Margin="0,20,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- 重走长征路 -->
        <Button Content="重走长征路"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,20,20"
                Padding="14,8"
                Foreground="#F4E4C1"
                Background="#C41E3A"
                BorderThickness="0"
                Cursor="Hand"
                Click="OnResetClick" />
    </Grid>
</Window>
